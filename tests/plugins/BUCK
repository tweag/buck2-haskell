# =============================================================================
# haskell_binary with real plugin (tools + opts) — the main test for tools
# =============================================================================

# Test: haskell_binary with real plugin that uses tools and plugin_opts.
# The plugin invokes "plugin_tool" at compile time (fails if not on PATH).
# The plugin replaces all string literals with "plugin_ok".
# At runtime, PluginMain.hs checks that "plugin" was replaced with "plugin_ok";
# the test fails if the replacement did not happen (i.e. opts were ignored).
haskell_binary(
    name = "bin_real_plugin_static",
    srcs = ["PluginMain.hs"],
    link_style = "static",
    plugins = [":real_plugin"],
    deps = [
        "//tests:base",
    ],
)

# Same test with shared linking.
haskell_binary(
    name = "bin_real_plugin_shared",
    srcs = ["PluginMain.hs"],
    link_style = "shared",
    plugins = [":real_plugin"],
    deps = [
        "//tests:base",
    ],
)

# =============================================================================
# sh_tests wrapping binaries — verify correct runtime behavior
# =============================================================================

sh_test(
    name = "test_bin_plugin_static_release",
    test = ":bin_plugin_static_release",
)

sh_test(
    name = "test_bin_plugin_static_debug",
    test = ":bin_plugin_static_debug",
)

sh_test(
    name = "test_bin_plugin_shared_release",
    test = ":bin_plugin_shared_release",
)

sh_test(
    name = "test_bin_plugin_shared_debug",
    test = ":bin_plugin_shared_debug",
)

sh_test(
    name = "test_bin_srcs_plugin_static_release",
    test = ":bin_srcs_plugin_static_release",
)

sh_test(
    name = "test_bin_srcs_plugin_shared_debug",
    test = ":bin_srcs_plugin_shared_debug",
)

# Test: real plugin with tools + opts, static linking.
# Compilation exercises the tool (readProcess). Runtime exercises the opts
# (string literal replacement). Fails if either tool or opts are missing.
sh_test(
    name = "test_bin_real_plugin_static",
    test = ":bin_real_plugin_static",
)

# Test: real plugin with tools + opts, shared linking.
sh_test(
    name = "test_bin_real_plugin_shared",
    test = ":bin_real_plugin_shared",
)

