    deps = [":lib_real_plugin"],
)

# =============================================================================
# Expected-failure tests (shell script)
# =============================================================================
# This test builds targets from expected_failures/ that are expected to fail,
# and verifies that the error messages match.  The sh_test itself succeeds
# when all expected failures produce the right errors.
sh_test(
    name = "test_expected_failures",
    test = "test_expected_failures.sh",
)
