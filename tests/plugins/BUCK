load(
    "@buck2-haskell//:defs.bzl",
    "ghc_plugin",
    "haskell_binary",
    "haskell_ghci",
    "haskell_haddock",
    "haskell_library",
    "haskell_test",
)

# =============================================================================
# Plugin library and ghc_plugin rule
# =============================================================================

# The noop plugin implementation library. It exports the NoopPlugin module which
# is a minimal GHC plugin that does nothing (uses defaultPlugin).
haskell_library(
    name = "noop_plugin_lib",
    srcs = ["NoopPlugin.hs"],
    deps = [
        "//tests:base",
        "//tests:ghc",
    ],
    visibility = ["//tests/..."],
)

# A ghc_plugin target wrapping the noop plugin library.
# This is the target that consumers reference via `plugins` or `srcs_plugins`.
ghc_plugin(
    name = "noop_plugin",
    module = "NoopPlugin",
    deps = [":noop_plugin_lib"],
    visibility = ["//tests/..."],
)

# =============================================================================
# Real plugin library: uses tools and plugin_opts
# =============================================================================
# The Plugin module:
# - Takes two options: [tool_name, replacement_string]
# - Invokes tool_name via readProcess (compile fails if tool not on PATH)
# - Replaces all string literals with replacement_string (runtime check)

haskell_library(
    name = "plugin_lib",
    srcs = ["Plugin.hs"],
    deps = [
        "//tests:base",
        "//tests:bytestring",
        "//tests:ghc",
        "//tests:process",
    ],
    visibility = ["//tests/..."],
)

# A trivial tool binary that the plugin invokes during compilation.
# If this tool is not available on PATH, the plugin's readProcess call
# throws an IOException and GHC reports a compilation failure.
haskell_binary(
    name = "plugin_tool",
    srcs = ["PluginTool.hs"],
    link_style = "static",
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
)

# ghc_plugin with tools and plugin_opts.
# - tools: the plugin_tool binary, which the plugin invokes at compile time.
# - plugin_opts: ["plugin_tool", "plugin_ok"]
#   * "plugin_tool" = the tool name the plugin will invoke via readProcess
#   * "plugin_ok"   = the replacement string for all string literals
ghc_plugin(
    name = "real_plugin",
    module = "Plugin",
    deps = [":plugin_lib"],
    tools = [":plugin_tool"],
    plugin_opts = ["plugin_tool", "plugin_ok"],
    visibility = ["//tests/..."],
)

# =============================================================================
# haskell_library targets with noop plugins (global)
# =============================================================================

# Test: haskell_library with global noop plugin, release build.
# Verifies that a noop plugin can be enabled for all modules in a library.
haskell_library(
    name = "lib_plugin_release",
    srcs = ["Lib.hs"],
    compiler_flags = ["-O2"],
    plugins = [":noop_plugin"],
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
)

# Test: haskell_library with global noop plugin, debug build.
haskell_library(
    name = "lib_plugin_debug",
    srcs = ["Lib.hs"],
    compiler_flags = ["-O0"],
    plugins = [":noop_plugin"],
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
)

# =============================================================================
# haskell_library targets with srcs_plugins (per-module)
# =============================================================================

# Test: haskell_library with per-module noop plugin, release build.
haskell_library(
    name = "lib_srcs_plugin_release",
    srcs = ["Lib.hs"],
    compiler_flags = ["-O2"],
    srcs_plugins = {
        "Lib.hs": [":noop_plugin"],
    },
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
)

# Test: haskell_library with per-module noop plugin, debug build.
haskell_library(
    name = "lib_srcs_plugin_debug",
    srcs = ["Lib.hs"],
    compiler_flags = ["-O0"],
    srcs_plugins = {
        "Lib.hs": [":noop_plugin"],
    },
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
)

# =============================================================================
# haskell_library with real plugin (tools + opts)
# =============================================================================

# Test: haskell_library compiled with the real plugin that invokes a tool and
# replaces string literals. The plugin_opts supply the tool name and the
# replacement string. Compilation fails if the tool is not on PATH.
haskell_library(
    name = "lib_real_plugin",
    srcs = ["PluginLib.hs"],
    plugins = [":real_plugin"],
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
)

