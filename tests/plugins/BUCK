# =============================================================================
# haskell_ghci targets with plugins
# =============================================================================

# GHCi with the real_plugin: when GHCi compiles GhciPluginTest.hs on load,
# the plugin replaces the "original" string literal with "plugin_ok".
haskell_ghci(
    name = "ghci_real_plugin",
    plugins = [":real_plugin"],
    deps = ["//tests:base"],
    ghci_bin_dep = "//tests:ghci_bin",
)

# GHCi with order_plugin: compilation only succeeds when plugin_opts arrive
# in the expected order.  Additional opts are passed via compiler_flags.
haskell_ghci(
    name = "ghci_order_plugin",
    plugins = [":order_plugin"],
    deps = ["//tests:base"],
    ghci_bin_dep = "//tests:ghci_bin",
    compiler_flags = [
        "-fplugin-opt=OrderPlugin:beta",
        "-fplugin-opt=OrderPlugin:gamma",
    ],
)

# =============================================================================
# haskell_haddock target with real plugin
# =============================================================================

haskell_haddock(
    name = "haddock_plugin",
    deps = [":lib_real_plugin"],
)

# =============================================================================
# Expected-failure tests (shell script)
# =============================================================================
# This test builds targets from expected_failures/ that are expected to fail,
# and verifies that the error messages match.  The sh_test itself succeeds
# when all expected failures produce the right errors.
sh_test(
    name = "test_expected_failures",
    test = "test_expected_failures.sh",
)

