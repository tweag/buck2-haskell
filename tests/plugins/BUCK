# =============================================================================
# Order plugin: verifies plugin_opts arrive in declared order
# =============================================================================

# The OrderPlugin library checks that its options are exactly
# ["alpha", "beta", "gamma"]. If they are missing or reordered,
# compilation fails with an error.
haskell_library(
    name = "order_plugin_lib",
    srcs = ["OrderPlugin.hs"],
    deps = [
        "//tests:base",
        "//tests:ghc",
    ],
    visibility = ["//tests/..."],
)

ghc_plugin(
    name = "order_plugin",
    module = "OrderPlugin",
    deps = [":order_plugin_lib"],
    plugin_opts = ["alpha", "beta", "gamma"],
    visibility = ["//tests/..."],
)

# Binary compiled with order_plugin — compilation succeeds only if
# plugin_opts arrive in the declared order.
haskell_binary(
    name = "bin_order_plugin",
    srcs = ["OrderMain.hs"],
    link_style = "static",
    plugins = [":order_plugin"],
    deps = ["//tests:base"],
)

sh_test(
    name = "test_bin_order_plugin",
    test = ":bin_order_plugin",
)

haskell_test(
    name = "ht_order_plugin",
    srcs = ["OrderMain.hs"],
    link_style = "static",
    plugins = [":order_plugin"],
    deps = ["//tests:base"],
)

# =============================================================================
# Expected-failure tests (shell script)
# =============================================================================
# This test builds targets from expected_failures/ that are expected to fail,
# and verifies that the error messages match.  The sh_test itself succeeds
# when all expected failures produce the right errors.
sh_test(
    name = "test_expected_failures",
    test = "test_expected_failures.sh",
)

# =============================================================================
# Previously broken targets (haddock, ghci, mutual exclusion)
# =============================================================================
# These have been moved to the expected_failures/ sub-package and are tested
# via test_expected_failures.sh, which verifies they fail with the expected
# error messages.
