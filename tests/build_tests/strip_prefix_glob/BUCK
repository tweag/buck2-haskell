load(
    "@buck2-haskell//:defs.bzl",
    "haskell_binary",
    "haskell_ghci",
    "haskell_library",
)

# Exercises `compute_source_module_paths` case 3 (list srcs, no module_prefix)
# in the strip_prefix-with-glob shape: srcs whose short_paths start with the
# stripped directory (e.g. `src/Stripped/Lib.hs`). Verifies the strip prefix
# reduces the in-tree path to `Stripped/Lib.hs` even though the package path is
# not "". See `export_file_src` for the same case with a target src.
haskell_library(
    name = "lib",
    srcs = glob(["src/**/*.hs"]),
    strip_prefix = ["src"],
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
    _worker = "toolchains//:persistent_worker",
)

haskell_binary(
    name = "bin",
    srcs = ["Main.hs"],
    link_style = "static",
    deps = [
        ":lib",
        "//tests:base",
    ],
    _worker = "toolchains//:persistent_worker",
)

sh_test(
    name = "test_bin",
    test = ":bin",
)

haskell_ghci(
    name = "ghci",
    ghci_bin_dep = "//tests:ghci_bin",
    deps = [
        ":lib",
        "//tests:base",
    ],
)

sh_test(
    name = "test_ghci",
    test = "test_ghci.sh",
    labels = ["buck2_run_from_project_root"],
    env = {
        "GHC_VERSION_MODIFIER": select({
            "root//constraints/ghc:ghc_version[ghc910]": "ghc910",
            "root//constraints/ghc:ghc_version[ghc914]": "ghc914",
        }),
    },
)
