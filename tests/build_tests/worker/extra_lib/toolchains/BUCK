load(
    "@buck2-haskell//:defs.bzl",
    "haskell_binary",
    "haskell_library",
)
load("@buck2-haskell//:worker_config.bzl", "worker_enabled")

#
# regular module transitively depends on toolchain FFI
#

haskell_library(
    name = "libA",
    srcs = [
        "src/A.hs",
    ],
    strip_prefix = ["src"],
    visibility = ["PUBLIC"],
    deps = [
        "//tests:base",
    ],
    extra_libraries = [
        "@toolchains//:zlib",
    ],
    _worker = "toolchains//:persistent_worker",
)

haskell_library(
    name = "libB",
    srcs = [
        "src/B.hs",
    ],
    strip_prefix = ["src"],
    visibility = ["PUBLIC"],
    deps = [
        "//tests:base",
        ":libA",
    ],
    _worker = "toolchains//:persistent_worker",
)

haskell_binary(
    name = "test1_bin",
    srcs = ["app/test1.hs"],
    strip_prefix = ["app"],
    visibility = ["PUBLIC"],
    deps = [
        "//tests:base",
        ":libB",
    ],
    _worker = "toolchains//:persistent_worker",
)

sh_test(
    name = "test1",
    test = ":test1_bin"
)

#
# TH module depends on toolchain FFI.
#

haskell_library(
    name = "libC",
    srcs = [
        "src/C.hs",
        "src/TH.hs",
    ],
    strip_prefix = ["src"],
    visibility = ["PUBLIC"],
    deps = [
        "//tests:base",
        "//tests:template-haskell",
        ":libA",
    ],
    _worker = "toolchains//:persistent_worker",
    # Only the worker supports incremental compilation with Template Haskell.
    incremental = worker_enabled(),
)


haskell_binary(
    name = "test2_bin",
    srcs = ["app/test2.hs"],
    strip_prefix = ["app"],
    visibility = ["PUBLIC"],
    deps = [
        "//tests:base",
        ":libC",
    ],
    _worker = "toolchains//:persistent_worker",
)

sh_test(
    name = "test2",
    test = ":test2_bin"
)
