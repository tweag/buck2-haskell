# =============================================================================
# Build configuration via constraints
# =============================================================================
# These targets use Buck2 constraints to control build type and link style,
# rather than hardcoding GHC flags or link_style attributes directly.
#
# Constraints used:
#   root//constraints/build_type:release  — compiles with -O2
#   root//constraints/build_type:debug    — compiles with -O0 (default)
#   root//constraints/link_style:static   — static linking (alias for static_pic)
#   root//constraints/link_style:shared   — dynamic linking
#
# Link style is driven by the CXX toolchain constraint (see
# toolchains/nix/default_toolchains.bzl), so haskell_binary and haskell_test
# do not set link_style explicitly.
#
# To test all configurations, run with different --modifier combinations:
#   buck test //tests/... --modifier root//constraints/link_style:static --modifier root//constraints/build_type:debug
#   buck test //tests/... --modifier root//constraints/link_style:static --modifier root//constraints/build_type:release
#   buck test //tests/... --modifier root//constraints/link_style:shared --modifier root//constraints/build_type:debug
#   buck test //tests/... --modifier root//constraints/link_style:shared --modifier root//constraints/build_type:release

# =============================================================================
# haskell_library
# =============================================================================
# Tests that haskell_library builds correctly under both build type constraints.
# Libraries use preferred_linkage = "any" (default) so they produce artifacts
# for all link styles; the active link style is selected by the consumer via the
# toolchain constraint.
#
# compiler_flags are set via select() on build_type because compiler_flags do
# not propagate from binary consumers to library dependencies in Buck2.
haskell_library(
    name = "lib",
    srcs = ["Lib.hs"],
    compiler_flags = select({
        "root//constraints/build_type:release": ["-O2"],
        "root//constraints/build_type:debug": ["-O0"],
        "DEFAULT": [],
    }),
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
)

