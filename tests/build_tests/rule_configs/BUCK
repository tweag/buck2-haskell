load(
    "@buck2-haskell//:defs.bzl",
    "haskell_binary",
    "haskell_ghci",
    "haskell_haddock",
    "haskell_library",
    "haskell_test",
)

# =============================================================================
# haskell_library targets
# =============================================================================
# Libraries use preferred_linkage = "any" (default) so they build artifacts for
# all link styles (static, static_pic, shared). The actual link style is
# exercised by the consumers (haskell_binary, haskell_test) that depend on them.

haskell_library(
    name = "lib",
    srcs = ["Lib.hs"],
    deps = ["//tests:base"],
    visibility = ["//tests/..."],
)

# =============================================================================
# haskell_haddock targets (documentation generation for haskell_library)
# =============================================================================

# Test: haddock documentation for lib.
haskell_haddock(
    name = "haddock_lib",
    deps = [":lib"],
)

# =============================================================================
# haskell_binary targets
# =============================================================================
# Each binary exercises a specific combination of link style (static/shared).
# The link_style attribute controls how the binary and its dependencies are linked.

haskell_binary(
    name = "bin_static",
    srcs = ["Main.hs"],
    link_style = "static",
    deps = [
        ":lib",
        "//tests:base",
    ],
)

# Test: haskell_binary with shared (dynamic) linking.
haskell_binary(
    name = "bin_shared",
    srcs = ["Main.hs"],
    link_style = "shared",
    deps = [
        ":lib",
        "//tests:base",
    ],
)

# Test: haskell_binary with custom main module name (shared)
haskell_binary(
    name = "bin_non_standard_shared",
    srcs = ["NonStandardMain.hs"],
    main = "Custom.MyMain",
    link_style = "shared",
    deps = [
        "//tests:base",
    ],
)

# Test: haskell_binary with custom main module name (static)
haskell_binary(
    name = "bin_non_standard_static",
    srcs = ["NonStandardMain.hs"],
    main = "Custom.MyMain",
    link_style = "static",
    deps = [
        "//tests:base",
    ],
)

# sh_tests that run each binary to verify correct linking and runtime behavior.
sh_test(
    name = "test_bin_static",
    test = ":bin_static",
)

sh_test(
    name = "test_bin_shared",
    test = ":bin_shared",
)

sh_test(
    name = "test_bin_non_standard_shared",
    test = ":bin_non_standard_shared",
)

sh_test(
    name = "test_bin_non_standard_static",
    test = ":bin_non_standard_static",
)

# =============================================================================
# haskell_test targets
# =============================================================================
# haskell_test is a test rule: it builds a Haskell binary and runs it as a
# test. Each target exercises a specific link style and build type combination.

haskell_test(
    name = "ht_static",
    srcs = ["TestMain.hs"],
    link_style = "static",
    deps = [
        ":lib",
        "//tests:base",
    ],
)

haskell_test(
    name = "ht_shared",
    srcs = ["TestMain.hs"],
    link_style = "shared",
    deps = [
        ":lib",
        "//tests:base",
    ],
)

# =============================================================================
# haskell_ghci targets
# =============================================================================

# Verifies the ghci script is generated correctly with library deps.
haskell_ghci(
    name = "ghci_lib",
    ghci_bin_dep = "//tests:ghci_bin",
    deps = [
        ":lib",
        "//tests:base",
    ],
)

genrule(
    name = "test_ghci.sh",
    srcs = [
        "test_ghci.sh.tpl",
    ],
    out = "test_ghci.sh",
    cmd = """
        sed -e 's|%GhciPluginTest.hs%|$(location //tests/plugins:GhciPluginTest.hs)|g' -e 's|%GhciOrderTest.hs%|$(location //tests/plugins:GhciOrderTest.hs)|g' test_ghci.sh.tpl >> $OUT
        chmod +x $OUT
""",
    executable = True,
)

# sh_test runs the ghci target via buck2 run and verifies Lib.greeting.
sh_test(
    name = "test_ghci",
    test = ":test_ghci.sh",
    labels = ["buck2_run_from_project_root"],
    # These sources are loaded by path inside GHCi during the test.
    # They must be listed as deps so they are materialized at test time
    # (deferred materialization won't materialize them otherwise).
    deps = [
        "//tests/plugins:GhciPluginTest.hs",
        "//tests/plugins:GhciOrderTest.hs",
    ],
)
