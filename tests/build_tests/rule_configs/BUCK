# =============================================================================
# haskell_binary
# =============================================================================
# Tests that haskell_binary builds and runs correctly. Link style is determined
# by the toolchain constraint (root//constraints/link_style). Build type
# (optimization level) is set via select() on root//constraints/build_type.
haskell_binary(
    name = "bin",
    srcs = ["Main.hs"],
    compiler_flags = select({
        "root//constraints/build_type:release": ["-O2"],
        "root//constraints/build_type:debug": ["-O0"],
        "DEFAULT": [],
    }),
    deps = [
        ":lib",
        "//tests:base",
    ],
)

# Runs the binary to verify correct linking and runtime behavior.
sh_test(
    name = "test_bin",
    test = ":bin",
)

# =============================================================================
# haskell_test
# =============================================================================
# Tests that haskell_test builds and executes correctly. Same constraint-driven
# configuration as haskell_binary above.
haskell_test(
    name = "ht",
    srcs = ["TestMain.hs"],
    compiler_flags = select({
        "root//constraints/build_type:release": ["-O2"],
        "root//constraints/build_type:debug": ["-O0"],
        "DEFAULT": [],
    }),
    deps = [
        ":lib",
        "//tests:base",
    ],
)

